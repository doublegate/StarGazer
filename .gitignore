# Rust build artifacts
/target/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment / secrets
.env
.env.*

# Local cache (user-specific, not for the repo), including the corrupt-file
# backup and atomic-write temp files `--cache` dev runs can leave behind
stars.json
stars.json.*
# Awesome-list data (v0.3.0) is written beside the star cache: index, lists,
# last chosen list, and their temp files
/awesome/

# Profiling / debug / coverage output
perf.data
perf.data.old
flamegraph.svg
*.profraw
lcov.info

# Local release packaging (CI builds the real archives)
/dist/

# Default landing place of the /tmp salvage tool: files rescued there are reviewed
# first, then moved to their real home and recorded in docs/SALVAGE_MANIFEST.md
/salvaged/

# Local agent instruction files (Master-Claude managed; import ~/.claude paths)
/AGENTS.md
/CLAUDE.md
/GEMINI.md
CLAUDE.local.md
*.mc-bak
.claude/settings.local.json

# Antigravity PR reviewer: large-diff on-disk handoff (transient, removed by the script).
/.agy-review-work/
